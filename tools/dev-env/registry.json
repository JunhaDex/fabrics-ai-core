{
  "servers": {
    "trama-web": {
      "dir": "projects/trama-web",
      "command": ["pnpm", "dev"],
      "ports": [3010],
      "env": { "PORT": "3010" }
    }
  },
  "tasks": {
    "android-emulator": {
      "dir": "tools/dev-env",
      "command": ["scripts/android-emulator.sh"],
      "env": {
        "ANDROID_AVD": "Medium_Phone_API_35",
        "EMULATOR_PORT": "5554"
      }
    }
  }
}
