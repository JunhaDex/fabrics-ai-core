{
  "cases": [
    {
      "name": "같은 트랜잭션에서 만든 노드를 바로 참조한다",
      "doc": {
        "schemaVersion": 1,
        "objects": {}
      },
      "tx": {
        "txId": "tx1",
        "actor": "user:test",
        "ops": [
          {
            "op": "create",
            "id": "frame1",
            "type": "frame",
            "parent": null,
            "placement": "last",
            "props": {
              "name": "Home"
            }
          },
          {
            "op": "create",
            "id": "sect01",
            "type": "section",
            "parent": "frame1",
            "placement": "last"
          },
          {
            "op": "create",
            "id": "box001",
            "type": "container",
            "parent": "sect01",
            "placement": "last",
            "props": {
              "layout.mode": "flex-row"
            }
          },
          {
            "op": "create",
            "id": "txt001",
            "type": "text",
            "parent": "box001",
            "placement": "first",
            "props": {
              "content": "a"
            }
          },
          {
            "op": "create",
            "id": "txt002",
            "type": "text",
            "parent": "box001",
            "placement": "last",
            "props": {
              "content": "b"
            }
          },
          {
            "op": "create",
            "id": "txt003",
            "type": "text",
            "parent": "box001",
            "placement": {
              "after": "txt001"
            },
            "props": {
              "content": "c"
            }
          },
          {
            "op": "create",
            "id": "txt004",
            "type": "text",
            "parent": "box001",
            "placement": {
              "before": "txt001"
            },
            "props": {
              "content": "d"
            }
          }
        ]
      },
      "expect": {
        "ok": true,
        "doc": {
          "schemaVersion": 1,
          "objects": {
            "frame1": {
              "type": "frame",
              "parent": null,
              "order": "a0",
              "name": "Home"
            },
            "sect01": {
              "type": "section",
              "parent": "frame1",
              "order": "a0"
            },
            "box001": {
              "type": "container",
              "parent": "sect01",
              "order": "a0",
              "layout.mode": "flex-row"
            },
            "txt001": {
              "type": "text",
              "parent": "box001",
              "order": "a0",
              "content": "a"
            },
            "txt002": {
              "type": "text",
              "parent": "box001",
              "order": "a1",
              "content": "b"
            },
            "txt003": {
              "type": "text",
              "parent": "box001",
              "order": "a0V",
              "content": "c"
            },
            "txt004": {
              "type": "text",
              "parent": "box001",
              "order": "Zz",
              "content": "d"
            }
          }
        }
      }
    },
