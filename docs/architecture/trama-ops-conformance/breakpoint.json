    {
      "name": "BP 생성과 override",
      "doc": {
        "schemaVersion": 1,
        "objects": {
          "frame1": {
            "type": "frame",
            "parent": null,
            "order": "a0",
            "name": "Home"
          },
          "sect01": {
            "type": "section",
            "parent": "frame1",
            "order": "a0"
          },
          "box001": {
            "type": "container",
            "parent": "sect01",
            "order": "a0"
          },
          "box002": {
            "type": "container",
            "parent": "box001",
            "order": "a0"
          },
          "txt001": {
            "type": "text",
            "parent": "sect01",
            "order": "a1",
            "content": "hello"
          }
        }
      },
      "tx": {
        "txId": "tx1",
        "actor": "user:test",
        "ops": [
          {
            "op": "create",
            "id": "bp0768",
            "type": "breakpoint",
            "parent": "frame1",
            "props": {
              "name": "Tablet",
              "minWidth": 768
            }
          },
          {
            "op": "set",
            "id": "box001",
            "props": {
              "layout.mode@bp:bp0768": "flex-row",
              "hidden@bp:bp0768": true
            }
          }
        ]
      },
      "expect": {
        "ok": true,
        "doc": {
          "schemaVersion": 1,
          "objects": {
            "frame1": {
              "type": "frame",
              "parent": null,
              "order": "a0",
              "name": "Home"
            },
            "sect01": {
              "type": "section",
              "parent": "frame1",
              "order": "a0"
            },
            "box001": {
              "type": "container",
              "parent": "sect01",
              "order": "a0",
              "layout.mode@bp:bp0768": "flex-row",
              "hidden@bp:bp0768": true
            },
            "box002": {
              "type": "container",
              "parent": "box001",
              "order": "a0"
            },
            "txt001": {
              "type": "text",
              "parent": "sect01",
              "order": "a1",
              "content": "hello"
            },
            "bp0768": {
              "type": "breakpoint",
              "parent": "frame1",
              "name": "Tablet",
              "minWidth": 768
            }
          }
        }
