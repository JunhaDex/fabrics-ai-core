{
  "cases": [
    {
      "name": "modifier·토큰 생성과 바인딩",
      "doc": {
        "schemaVersion": 1,
        "objects": {
          "frame1": {
            "type": "frame",
            "parent": null,
            "order": "a0",
            "name": "Home"
          },
          "sect01": {
            "type": "section",
            "parent": "frame1",
            "order": "a0"
          },
          "box001": {
            "type": "container",
            "parent": "sect01",
            "order": "a0"
          },
          "box002": {
            "type": "container",
            "parent": "box001",
            "order": "a0"
          },
          "txt001": {
            "type": "text",
            "parent": "sect01",
            "order": "a1",
            "content": "hello"
          }
        }
      },
      "tx": {
        "txId": "tx1",
        "actor": "user:test",
        "ops": [
          {
            "op": "create",
            "id": "palette",
            "type": "modifier",
            "parent": null,
            "props": {
              "name": "palette",
              "contexts": [
                "brand",
                "mono"
              ],
              "default": "brand"
            }
          },
          {
            "op": "create",
            "id": "tkBlue1",
            "type": "token",
            "parent": null,
            "props": {
              "name": "color.blue",
              "tokenType": "color",
              "value": {
                "colorSpace": "srgb",
                "components": [
                  0.2,
                  0.4,
                  1
                ]
              },
              "variesBy": "palette",
              "value@ctx:mono": {
                "colorSpace": "srgb",
                "components": [
                  0.5,
                  0.5,
                  0.5
                ]
              }
            }
          },
          {
            "op": "create",
            "id": "tkPrim1",
            "type": "token",
            "parent": null,
            "props": {
              "name": "color.primary",
              "tokenType": "color",
              "value": {
                "ref": "tkBlue1"
              },
              "variesBy": "_mode",
              "value@ctx:dark": {
                "colorSpace": "srgb",
                "components": [
                  1,
                  1,
                  1
                ]
              }
            }
          },
          {
            "op": "set",
            "id": "box001",
            "props": {
              "style.background-color": {
                "token": "tkPrim1"
              },
              "style.color": {
                "token": "tkBlue1"
              }
            }
          }
        ]
      },
      "expect": {
        "ok": true,
        "doc": {
          "schemaVersion": 1,
          "objects": {
            "frame1": {
              "type": "frame",
              "parent": null,
              "order": "a0",
              "name": "Home"
            },
            "sect01": {
              "type": "section",
              "parent": "frame1",
              "order": "a0"
            },
            "box001": {
              "type": "container",
              "parent": "sect01",
              "order": "a0",
              "style.background-color": {
                "token": "tkPrim1"
              },
              "style.color": {
                "token": "tkBlue1"
              }
            },
            "box002": {
              "type": "container",
              "parent": "box001",
              "order": "a0"
            },
            "txt001": {
              "type": "text",
              "parent": "sect01",
              "order": "a1",
              "content": "hello"
            },
            "palette": {
              "type": "modifier",
              "parent": null,
              "name": "palette",
              "contexts": [
                "brand",
                "mono"
              ],
              "default": "brand"
            },
            "tkBlue1": {
              "type": "token",
              "parent": null,
              "name": "color.blue",
              "tokenType": "color",
              "value": {
                "colorSpace": "srgb",
                "components": [
                  0.2,
                  0.4,
                  1
                ]
              },
              "variesBy": "palette",
              "value@ctx:mono": {
                "colorSpace": "srgb",
                "components": [
                  0.5,
                  0.5,
                  0.5
                ]
              }
            },
            "tkPrim1": {
              "type": "token",
              "parent": null,
              "name": "color.primary",
              "tokenType": "color",
              "value": {
                "ref": "tkBlue1"
              },
              "variesBy": "_mode",
              "value@ctx:dark": {
                "colorSpace": "srgb",
                "components": [
                  1,
                  1,
                  1
                ]
              }
            }
          }
        },
        "warnings": [
          {
            "code": "RAW_TOKEN_BOUND",
            "id": "box001",
            "key": "style.color"
          }
        ]
      }
    },
